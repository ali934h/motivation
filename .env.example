# Client-side (Vite) env vars — set these in Cloudflare Pages dashboard
# Build environment variables, and also referenced at build time.

VITE_PANEL_PATH=your-secret-panel-path-abc123
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset-name

# Server-side (Pages Functions) env vars — set these in Cloudflare Pages
# dashboard under Settings > Environment Variables (Production & Preview).
# These are NOT prefixed with VITE_ because they must stay out of the
# client-side bundle.

PANEL_SECRET_PATH=your-secret-panel-path-abc123
SESSION_TTL_SECONDS=604800
